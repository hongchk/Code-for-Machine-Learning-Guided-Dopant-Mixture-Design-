                                'MinEStateIndex', 'BalabanJ', 'fr_para_hydroxylation'], 
                  select_mix_col=['fr_NH1', 'fr_bicyclic', 'NumAromaticCarbocycles',  
                                  'FractionCSP3', 'fr_methoxy', 'VSA_EState6'],  
