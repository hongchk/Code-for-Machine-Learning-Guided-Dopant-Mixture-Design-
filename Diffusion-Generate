def evaluate_particle(particle, rf_model, fixed_m, columns, general_columns, select_B_col, select_mix_col):
    try:
        features = np.concatenate([particle, fixed_m])
        features_df = pd.DataFrame(features.reshape(1, -1),
                                   columns=(general_columns + select_B_col + select_mix_col))

        y_pred = proton_prediction(rf_model, features_df, columns)[0][0]
        return y_pred
    except Exception as e:
        print(f"bead asses error: {str(e)}")
        return -np.inf  


def integer_pso(rf_model, fixed_m, e_bounds, num_particles=30, max_iter=50,
                         columns=['D', 'PA', 'MX', 'T', 'VSAE3', 'VSAE2', 'EVSA8',
                                  'MESI', 'BJ', 'para_H', 'NH1', 'bicyc', 'NACC', 'CSP3', 'MO', 'VSAE6'],
                         select_B_col=['VSA_EState3', 'VSA_EState2', 'EState_VSA8',  
                                       'MinEStateIndex', 'BalabanJ', 'fr_para_hydroxylation'],  
                         select_mix_col=['fr_NH1', 'fr_bicyclic', 'NumAromaticCarbocycles',  
                                         'FractionCSP3', 'fr_methoxy', 'VSA_EState6'],  
                         general_columns=['thickness', 'PA uptake', 'mix uptake', 'temperature'],
                         n_workers=None):
    dim = len(e_bounds)

    particles = np.zeros((num_particles, dim), dtype=int)
    velocities = np.zeros((num_particles, dim))
    for i in range(num_particles):
        for j in range(dim):
            low, high = e_bounds[j]
            particles[i, j] = np.random.randint(low, high + 1)


    pbest = particles.copy()
    pbest_scores = np.full(num_particles, -np.inf)

    gbest = particles[0].copy()
    gbest_score = -np.inf

    w = 0.6  # weight
    c1, c2 = 0.8, 0.8  

    if n_workers is None:
        n_workers = multiprocessing.cpu_count()

    evaluate_func = partial(
        evaluate_particle,
        rf_model=rf_model,
        fixed_m=fixed_m,
        columns=columns,
        general_columns=general_columns,
        select_B_col=select_B_col,
        select_mix_col=select_mix_col
    )

    history = []

    with multiprocessing.Pool(processes=n_workers) as pool:
        for iter in tqdm(range(max_iter), desc="PSO process"):
            y_preds = pool.map(evaluate_func, particles)
            for i in range(num_particles):
                y_pred = y_preds[i]
                if y_pred > pbest_scores[i]:
                    pbest_scores[i] = y_pred
                    pbest[i] = particles[i].copy()

                if y_pred > gbest_score:
                    gbest_score = y_pred
                    gbest = particles[i].copy()

            history.append(gbest_score)
            for i in range(num_particles):
                for d in range(dim):
                    r1, r2 = np.random.random(), np.random.random()
                    velocities[i, d] = (w * velocities[i, d] +
                                        c1 * r1 * (pbest[i, d] - particles[i, d]) +
                                        c2 * r2 * (gbest[d] - particles[i, d]))

                    new_pos = particles[i, d] + velocities[i, d]

                    low, high = e_bounds[d]
                    particles[i, d] = np.clip(int(round(new_pos)), low, high)

    return gbest, gbest_score


